# =====================================================================
# Daily Planner - Environment Variables Template
# =====================================================================

# 1. Supabase (Database, Auth & Realtime)
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@dailyplanner.app

# 3. 1-Minute Cron Scheduler
# Secure string to prevent unauthorized execution of /api/cron/send-reminders
CRON_SECRET=your-random-cron-secret-token

# 4. AI Assistant (Default: Groq, Swappable: NVIDIA)
AI_PROVIDER=groq
# For Groq:
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_your_groq_api_key
AI_MODEL=llama-3.3-70b-versatile

# For NVIDIA (simply change these variables in your deployment):
# AI_PROVIDER=nvidia
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_API_KEY=nvapi_your_nvidia_api_key
# AI_MODEL=meta/llama-3.1-70b-instruct
